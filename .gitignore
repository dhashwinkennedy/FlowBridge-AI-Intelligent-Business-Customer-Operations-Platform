# ==============================================================================
# AxiomX Monorepo Root Git Ignore
# ==============================================================================

# Credentials and secrets (CRITICAL)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# Testing and Type Checking
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
test-results/

# Node.js and Frontend
node_modules/
dist/
dist-ssr/
build/
*.tsbuildinfo
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Uploads & Storage (Keep folder structure, ignore uploaded files)
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
BACKEND/uploads/*
!BACKEND/uploads/.gitkeep

# IDEs & System Artifacts
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Temporary logs & debugging files
*.log
logs/
tmp/
temp/
