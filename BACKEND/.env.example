# ==============================================================================
# AxiomX Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholders with your actual credentials.
# NEVER commit the real .env file with production credentials to source control.

# Application Core Configuration
APP_NAME=AxiomX
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# MongoDB Atlas Database Configuration
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net
MONGODB_URI=mongodb+srv://db_user:db_password@your-cluster.mongodb.net
MONGODB_DATABASE=axiomx

# Pinecone Vector Database Configuration
# Existing index must match: name='axiomx-knowledge', model='llama-text-embed-v2', dim=1024, metric='cosine'
PINECONE_API_KEY=pcsk_your_pinecone_api_key_here
PINECONE_INDEX_NAME=axiomx-knowledge
PINECONE_INDEX_HOST=https://axiomx-knowledge-yourid.svc.aped-4627-b74a.pinecone.io
PINECONE_EMBEDDING_FIELD=chunk_text
PINECONE_TITLE_FIELD=title
PINECONE_NAMESPACE_PREFIX=company_
PINECONE_BATCH_SIZE=96

# OpenRouter LLM Configuration
# Recommended model: openai/gpt-4o-mini or nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_TIMEOUT=30
OPENROUTER_APP_NAME=AxiomX Copilot

# Security & JWT Authentication
# Generate a secure 32+ byte hex key for production: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_a_secure_random_secret_key_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# Document Upload & Ingestion Settings
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
CHUNK_SIZE_CHARS=3600
CHUNK_OVERLAP_CHARS=500
ALLOWED_DOCUMENT_EXTENSIONS=.pdf,.docx,.txt
RAG_TOP_K=5
CUSTOMER_KNOWLEDGE_TYPE=customer
INTERNAL_KNOWLEDGE_TYPE=internal

# Email & Notification Settings (SMTP)
# Set SMTP_ENABLED=true and configure your SMTP credentials to enable email alerts
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM_EMAIL=notifications@axiomx.local
SMTP_FROM_NAME=AxiomX Notifications
SMTP_USE_TLS=true

# Background Task Scheduler (APScheduler)
# Multi-worker deployments should note single-instance scheduling constraints
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=UTC
REMINDER_CHECK_INTERVAL_MINUTES=15
DEFAULT_TASK_REMINDER_HOURS=24
DEFAULT_APPROVAL_REMINDER_HOURS=12

# Logging Configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
