# ==============================================================================
# AxiomX Frontend Environment Configuration Template
# ==============================================================================
# Copy this file to .env to configure frontend environment parameters.
# Only variables prefixed with VITE_ are exposed to the browser client.

# Backend FastAPI Service Base URL
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Frontend Application Title
VITE_APP_TITLE=AxiomX Operations Copilot
